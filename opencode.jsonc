{
  "$schema": "https://opencode.ai/config.json",

  // LSP for this static HTML/CSS/JS portfolio. Binaries are global installs
  // (node v22) referenced by absolute path. `command` is an ARRAY (binary + flags).
  "lsp": {
    "html": {
      "command": ["/home/argabiyusyrf/.local/opt/node-v22.14.0-linux-x64/bin/vscode-html-language-server", "--stdio"],
      "extensions": [".html", ".htm"]
    },
    "css": {
      "command": ["/home/argabiyusyrf/.local/opt/node-v22.14.0-linux-x64/bin/vscode-css-language-server", "--stdio"],
      "extensions": [".css", ".scss", ".less"]
    },
    "javascript": {
      "command": ["/home/argabiyusyrf/.local/opt/node-v22.14.0-linux-x64/bin/typescript-language-server", "--stdio"],
      "extensions": [".js", ".mjs", ".cjs"],
      "initialization": { "preferences": { "includeInlayParameterNameHints": "none" } }
    },
    "json": {
      "command": ["/home/argabiyusyrf/.local/opt/node-v22.14.0-linux-x64/bin/vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    }
  },

  // MCP servers useful for this repo. Pre-installed under ~/.local/mcp and launched
  // directly via the absolute `node` binary (NO `npx` — avoids the 30s startup timeout).
  "mcp": {
    "context7": {
      "type": "local",
      "enabled": true,
      "command": ["/home/argabiyusyrf/.local/opt/node-v22.14.0-linux-x64/bin/node", "/home/argabiyusyrf/.local/mcp/node_modules/@upstash/context7-mcp/dist/index.js"]
    },
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": ["/home/argabiyusyrf/.local/opt/node-v22.14.0-linux-x64/bin/node", "/home/argabiyusyrf/.local/mcp/node_modules/@modelcontextprotocol/server-filesystem/dist/index.js", "/var/www/html/portfolio-3d", "/home/argabiyusyrf"]
    },
    "memory": {
      "type": "local",
      "enabled": true,
      "command": ["/home/argabiyusyrf/.local/opt/node-v22.14.0-linux-x64/bin/node", "/home/argabiyusyrf/.local/mcp/node_modules/@modelcontextprotocol/server-memory/dist/index.js"]
    },
    "everything": {
      "type": "local",
      "enabled": true,
      "command": ["/home/argabiyusyrf/.local/opt/node-v22.14.0-linux-x64/bin/node", "/home/argabiyusyrf/.local/mcp/node_modules/@modelcontextprotocol/server-everything/dist/index.js"]
    }
  }
}
