{
  "$schema": "https://opencode.ai/config.json",

  // MCP servers for this repo. All binaries are global installs under
  // ~/.npm-global/bin, launched directly (NO `npx` — avoids the 30s startup
  // timeout). The language servers this repo needs are already registered in
  // the global config (~/.config/opencode/opencode.jsonc), so no `lsp` block here.
  "mcp": {
    "context7": {
      "type": "local",
      "enabled": true,
      "command": ["/home/argaabiyyu/.npm-global/bin/context7-mcp"]
    },
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": ["/home/argaabiyyu/.npm-global/bin/mcp-server-filesystem", "/var/www/html/MyPortofolio", "/home/argaabiyyu"]
    },
    "memory": {
      "type": "local",
      "enabled": true,
      "command": ["/home/argaabiyyu/.npm-global/bin/mcp-server-memory"]
    },
    "everything": {
      "type": "local",
      "enabled": true,
      "command": ["/home/argaabiyyu/.npm-global/bin/mcp-server-everything"]
    }
  }
}
